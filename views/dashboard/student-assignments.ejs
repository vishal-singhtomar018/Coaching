<%- include('../partials/head') %><%- include('../partials/navbar') %><%- include('../partials/dashboard-nav') %>
            <section class="max-w-7xl mx-auto px-6 py-16 min-h-[calc(100vh-80px)]">
                <h1 class="font-serif text-4xl mb-8">Homework & Assignments</h1>
                <div class="grid gap-5">
                    <% assignments.forEach(a=>{ %><div class="bg-white shadow rounded-xl p-6">
                            <div class="flex justify-between">
                                <h2 class="text-2xl font-semibold">
                                    <%=a.title%>
                                </h2><span class="px-3 py-1 rounded-full bg-gray-100">
                                    <%=a.status%>
                                </span>
                            </div>
                            <p class="text-gray-600 mt-2">
                                <%=a.description||''%>
                            </p>
                            <p class="text-sm mt-3">Due: <%=a.dueDate?a.dueDate.toLocaleDateString():'Not specified'%>
                            </p>
                            <% if(a.status==='pending' ){ %>
                                <form method="post" action="/student/assignments/<%=a._id%>/submit" class="mt-4">
                                    <textarea name="submission" required class="w-full border rounded p-3"
                                        placeholder="Write your answer/submission..."></textarea><button
                                        class="mt-3 bg-[#c9a15f] text-white px-5 py-2 rounded">Submit</button></form>
                                <% } else if(a.submission){ %>
                                    <div class="mt-4 bg-gray-50 p-4 rounded"><b>Your submission:</b>
                                        <p>
                                            <%=a.submission%>
                                        </p>
                                    </div>
                                    <% } %>
                        </div>
                        <% }) %>
                </div>
            </section>
            </main><%- include('../partials/footer') %>