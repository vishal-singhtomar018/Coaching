<%- include('../partials/head') %><%- include('../partials/navbar') %><%- include('../partials/dashboard-nav') %>
            <section class="max-w-7xl mx-auto px-6 py-16 min-h-[calc(100vh-80px)]">
                <h1 class="font-serif text-4xl mb-8">Tests & Results</h1>
                <div class="grid gap-4">
                    <% tests.forEach(t=>{ %><div class="bg-white shadow rounded-xl p-6">
                            <div class="flex justify-between">
                                <h2 class="text-xl font-semibold">
                                    <%=t.title%>
                                </h2><span>
                                    <%=t.status%>
                                </span>
                            </div>
                            <p>
                                <%=t.description||''%>
                            </p>
                            <p class="mt-2">Date: <%=t.testDate?t.testDate.toLocaleString():'—'%> · Max Marks:
                                    <%=t.maxMarks%>
                            </p>
                            <% if(t.status==='completed' ){ %>
                                <div class="mt-3 font-semibold">Score: <%=t.marks%>/<%=t.maxMarks%>
                                </div>
                                <p>
                                    <%=t.feedback||''%>
                                </p>
                                <% } %>
                        </div>
                        <% }) %>
                </div>
                </section>
            </main><%- include('../partials/footer') %>