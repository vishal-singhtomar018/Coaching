<%- include('../partials/head') %><%- include('../partials/navbar') %><%- include('../partials/dashboard-nav') %>
<section class="bg-[#f8f7f5] min-h-screen py-12"><div class="max-w-7xl mx-auto px-6"><h1 class="font-serif text-5xl">Welcome, <%= student.studentName %> 👋</h1><p class="text-gray-500 mt-2 mb-8">Your complete learning dashboard.</p>
<div class="grid md:grid-cols-2 xl:grid-cols-4 gap-5 mb-8"><% const stats=[['Homework',assignments.length,'/student/assignments'],['Attendance',attendance.length,'/student/attendance'],['Materials',materials.length,'/student/materials'],['Tests',tests.length,'/student/tests']]; stats.forEach(x=>{ %><a href="<%=x[2]%>" class="bg-white rounded-xl shadow p-6 hover:-translate-y-1 transition"><div class="text-4xl font-serif text-[#c9a15f]"><%=x[1]%></div><div class="text-gray-500 mt-2"><%=x[0]%></div></a><% }) %></div>
<div class="grid lg:grid-cols-3 gap-6"><div class="bg-white rounded-xl shadow p-7 lg:col-span-2"><h2 class="font-serif text-3xl mb-5">Assigned Tutor</h2><% if(student.assignedTutor){ %><div class="grid md:grid-cols-2 gap-4"><p><b>Name:</b> <%=student.assignedTutor.name%></p><p><b>Subject:</b> <%=student.assignedTutor.subjectExpertise%></p><p><b>Experience:</b> <%=student.assignedTutor.experience%></p><p><b>Contact:</b> <%=student.assignedTutor.contactNumber%></p><p><b>Time:</b> <%=student.timeSlot%></p><p><b>Location:</b> <%=student.currentLocation%></p></div><% } else { %><div class="bg-yellow-50 p-5 rounded">No tutor has been assigned yet.</div><% } %></div><div class="bg-white rounded-xl shadow p-7"><h2 class="font-serif text-3xl mb-5">Latest Notifications</h2><% notifications.slice(0,5).forEach(n=>{ %><div class="border-b py-3"><b><%=n.title%></b><p class="text-sm text-gray-500"><%=n.message%></p></div><% }) %><a href="/student/notifications" class="inline-block mt-4 text-[#a27d3f]">View all →</a></div></div>
<div class="grid lg:grid-cols-2 gap-6 mt-6"><div class="bg-white rounded-xl shadow p-7"><h2 class="font-serif text-3xl mb-4">Upcoming Schedule</h2><% schedules.slice(0,5).forEach(s=>{ %><div class="border-b py-3"><b><%=s.day%> · <%=s.startTime%>-<%=s.endTime%></b><p><%=s.subject%> · <%=s.location||'Online/To be confirmed'%></p></div><% }) %><a href="/student/schedule" class="inline-block mt-4 text-[#a27d3f]">Full schedule →</a></div><div class="bg-white rounded-xl shadow p-7"><h2 class="font-serif text-3xl mb-4">Progress</h2><% progress.slice(0,5).forEach(p=>{ %><div class="mb-3"><div class="flex justify-between"><span><%=p.topic||'General'%></span><b><%=p.score??'—'%>%</b></div><div class="h-2 bg-gray-200 rounded"><div class="h-2 bg-[#c9a15f] rounded" style="width:<%=p.score||0%>%"></div></div></div><% }) %><a href="/student/progress" class="inline-block mt-4 text-[#a27d3f]">View progress →</a></div></div>
</div></section><%- include('../partials/footer') %>
