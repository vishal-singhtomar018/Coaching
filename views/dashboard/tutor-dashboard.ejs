<%- include('../partials/head') %><%- include('../partials/navbar') %><%- include('../partials/dashboard-nav') %><section class="bg-[#f8f7f5] min-h-screen py-12"><div class="max-w-7xl mx-auto px-6"><div class="flex justify-between items-center mb-8"><div><h1 class="font-serif text-5xl">Welcome, <span class="text-[#c9a15f]"><%=tutor.name%></span> 👋</h1><p class="text-gray-500 mt-2">Manage students and academic activities.</p></div><span class="bg-green-100 text-green-700 px-4 py-2 rounded-full"><%=tutor.status%></span></div><div class="grid md:grid-cols-2 xl:grid-cols-4 gap-5 mb-8"><% [['Students',students.length,'/tutor/students'],['Homework',assignments.length,'/tutor/homework'],['Attendance',attendance.length,'/tutor/attendance'],['Notifications',notifications.length,'/tutor/notifications']].forEach(x=>{ %><a href="<%=x[2]%>" class="bg-white rounded-xl shadow p-6 hover:-translate-y-1 transition"><div class="text-4xl font-serif text-[#c9a15f]"><%=x[1]%></div><div class="text-gray-500 mt-2"><%=x[0]%></div></a><% }) %></div><div class="grid lg:grid-cols-3 gap-6"><div class="bg-white rounded-xl shadow p-7 lg:col-span-2"><h2 class="font-serif text-3xl mb-5">Assigned Students</h2><% students.slice(0,8).forEach(s=>{ %><div class="flex justify-between border-b py-4"><div><b><%=s.studentName%></b><p class="text-sm text-gray-500">Class <%=s.class%> · <%=s.subject%></p></div><a href="/tutor/student/<%=s._id%>" class="text-[#a27d3f]">View →</a></div><% }) %><a href="/tutor/students" class="inline-block mt-4 text-[#a27d3f]">Manage students →</a></div><div class="bg-white rounded-xl shadow p-7"><h2 class="font-serif text-3xl mb-5">Quick Actions</h2><div class="grid gap-3"><a class="p-3 rounded bg-gray-100 hover:bg-[#c9a15f] hover:text-white" href="/tutor/homework">📝 Assign Homework</a><a class="p-3 rounded bg-gray-100 hover:bg-[#c9a15f] hover:text-white" href="/tutor/attendance">📅 Mark Attendance</a><a class="p-3 rounded bg-gray-100 hover:bg-[#c9a15f] hover:text-white" href="/tutor/notes">📚 Add Materials</a><a class="p-3 rounded bg-gray-100 hover:bg-[#c9a15f] hover:text-white" href="/tutor/tests">📖 Manage Tests</a><a class="p-3 rounded bg-gray-100 hover:bg-[#c9a15f] hover:text-white" href="/tutor/progress">📈 Update Progress</a></div></div></div></div></section><%- include('../partials/footer') %>
