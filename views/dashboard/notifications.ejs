<%- include('../partials/head') %><%- include('../partials/navbar') %><%- include('../partials/dashboard-nav') %>

            <section class="max-w-7xl mx-auto px-6 py-16 min-h-[calc(100vh-80px)]">
                <h1 class="font-serif text-4xl mb-8">Notifications</h1>
                <div class="grid gap-3">
                    <% notifications.forEach(n=>{ %><div class="bg-white shadow rounded-xl p-5"><b>
                                <%=n.title%>
                            </b>
                            <p class="text-gray-600">
                                <%=n.message%>
                            </p><small class="text-gray-400">
                                <%=n.createdAt.toLocaleString()%>
                            </small>
                        </div>
                        <% }) %>
                </div>
                </section>
                </main><%- include('../partials/footer') %>