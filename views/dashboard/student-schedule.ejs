<%- include('../partials/head') %><%- include('../partials/navbar') %><%- include('../partials/dashboard-nav') %>
            <section class="max-w-7xl mx-auto px-6 py-16 min-h-[calc(100vh-80px)]">
                <h1 class="font-serif text-4xl mb-8">Class Schedule</h1>
                <div class="grid md:grid-cols-2 gap-5">
                    <% schedules.forEach(s=>{ %><div class="bg-white shadow rounded-xl p-6">
                            <h2 class="text-2xl font-semibold">
                                <%=s.day%>
                            </h2>
                            <p class="text-[#a27d3f] text-lg">
                                <%=s.startTime%> - <%=s.endTime%>
                            </p>
                            <p class="mt-2"><b>
                                    <%=s.subject%>
                                </b></p>
                            <p>
                                <%=s.location||'Location not specified'%>
                            </p>
                            <p class="text-gray-500 mt-2">
                                <%=s.notes||''%>
                            </p>
                        </div>
                        <% }) %>
                </div>
                </section>
            </main><%- include('../partials/footer') %>