<%- include('../partials/head') %><%- include('../partials/navbar') %><%- include('../partials/dashboard-nav') %><main class="max-w-7xl mx-auto px-6 py-12"><h1 class="font-serif text-4xl mb-8">Student Progress</h1><form method="post" action="/tutor/progress" class="bg-white shadow rounded-xl p-6 grid md:grid-cols-2 gap-3 mb-8"><select name="student" required class="border rounded p-3"><option value="">Student</option><% students.forEach(s=>{ %><option value="<%=s._id%>"><%=s.studentName%></option><% }) %></select><input name="topic" placeholder="Topic / skill" class="border rounded p-3"><input name="score" type="number" min="0" max="100" placeholder="Score %" class="border rounded p-3"><input name="remark" placeholder="Remark" class="border rounded p-3"><button class="bg-[#c9a15f] text-white py-3 rounded md:col-span-2">Update Progress</button></form><div class="grid gap-4"><% progress.forEach(p=>{ %><div class="bg-white shadow rounded-xl p-5"><div class="flex justify-between"><b><%=p.student?.studentName%> — <%=p.topic||'General'%></b><b><%=p.score??'—'%>%</b></div><div class="h-2 bg-gray-200 rounded mt-2"><div class="h-2 bg-[#c9a15f] rounded" style="width:<%=p.score||0%>%"></div></div><p class="mt-2 text-gray-600"><%=p.remark||''%></p></div><% }) %></div></main><%- include('../partials/footer') %>
