<%- include('../partials/head') %><%- include('../partials/navbar') %><%- include('../partials/dashboard-nav') %>
            <section class="max-w-7xl mx-auto px-6 py-16 min-h-[calc(100vh-80px)]">
                <h1 class="font-serif text-4xl mb-8">My Progress</h1>
                <div class="grid gap-5">
                    <% progress.forEach(p=>{ %><div class="bg-white shadow rounded-xl p-6">
                            <div class="flex justify-between"><b>
                                    <%=p.topic||'General Progress'%>
                                </b><b>
                                    <%=p.score??'—'%>%
                                </b></div>
                            <div class="h-3 bg-gray-200 rounded mt-3">
                                <div class="h-3 bg-[#c9a15f] rounded" style="width:<%=p.score||0%>%"></div>
                            </div>
                            <p class="mt-3 text-gray-600">
                                <%=p.remark||''%>
                            </p>
                        </div>
                        <% }) %>
                </div>
                </section>
            </main><%- include('../partials/footer') %>