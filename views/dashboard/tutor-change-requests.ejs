<%- include('../partials/head') %><%- include('../partials/navbar') %>
        <section class="max-w-7xl mx-auto px-6 py-16 min-h-[calc(100vh-80px)]">
            <h1 class="font-serif text-4xl mb-8">Tutor Change Requests</h1>
            <div class="grid gap-5">
                <% requests.forEach(r=>{ %><div class="bg-white shadow rounded-xl p-6">
                        <div class="flex justify-between">
                            <h2 class="text-xl font-semibold">
                                <%=r.student?.studentName%>
                            </h2><span>
                                <%=r.status%>
                            </span>
                        </div>
                        <p class="mt-2">Current tutor: <%=r.currentTutor?.name||'None'%>
                        </p>
                        <p class="text-gray-600 mt-2">Reason: <%=r.reason%>
                        </p>
                        <% if(r.status==='pending' ){ %>
                            <form method="post" action="/admin/tutor-change-requests/<%=r._id%>" class="mt-4"><textarea
                                    name="adminNote" class="w-full border rounded p-3"
                                    placeholder="Admin note (optional)"></textarea>
                                <div class="flex gap-3 mt-3"><button name="action" value="approve"
                                        class="bg-green-600 text-white px-5 py-2 rounded">Approve</button><button
                                        name="action" value="reject"
                                        class="bg-red-600 text-white px-5 py-2 rounded">Reject</button></div>
                            </form>
                            <% } %>
                    </div>
                    <% }) %>
            </div>
            </section>
        </main><%- include('../partials/footer') %>