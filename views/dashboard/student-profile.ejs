<%- include('../partials/head') %><%- include('../partials/navbar') %><%- include('../partials/dashboard-nav') %><main class="max-w-6xl mx-auto px-6 py-12"><h1 class="font-serif text-4xl mb-8">My Profile</h1><form method="post" action="/student/profile" class="bg-white shadow rounded-xl p-7 grid md:grid-cols-2 gap-4"><% [['studentName','Student Name'],['class','Class'],['subject','Subject'],['school','School'],['board','Board'],['medium','Medium'],['duration','Duration'],['timeSlot','Time Slot'],['currentLocation','Location'],['landmark','Landmark'],['permanentAddress','Permanent Address'],['parentName','Parent Name'],['parentOccupation','Parent Occupation'],['studentContact','Student Contact'],['parentContact','Parent Contact'],['whatsappNumber','WhatsApp'],['email','Email']].forEach(x=>{ %><label><span class="text-sm text-gray-500"><%=x[1]%></span><input name="<%=x[0]%>" value="<%=student[x[0]]||''%>" class="w-full border rounded p-3"></label><% }) %><button class="md:col-span-2 bg-[#c9a15f] text-white py-3 rounded">Save Profile</button></form><form method="post" action="/student/change-password" class="bg-white shadow rounded-xl p-7 mt-6"><h2 class="font-serif text-2xl mb-4">Change Password</h2><div class="grid md:grid-cols-3 gap-3"><input type="password" name="currentPassword" required placeholder="Current password" class="border rounded p-3"><input type="password" name="password" required minlength="6" placeholder="New password" class="border rounded p-3"><input type="password" name="confirmPassword" required placeholder="Confirm password" class="border rounded p-3"></div><button class="mt-4 bg-black text-white px-5 py-3 rounded">Change Password</button></form><% if(student.assignedTutor){ %><section class="bg-white shadow rounded-xl p-7 mt-6"><h2 class="font-serif text-2xl mb-3">Request Tutor Change</h2><p class="text-gray-500 mb-4">If you need a different tutor, submit a reason for the administrator.</p><form method="post" action="/student/request-tutor-change"><textarea name="reason" required class="w-full border rounded p-3" placeholder="Reason for requesting a tutor change"></textarea><button class="mt-3 bg-red-600 text-white px-5 py-3 rounded">Submit Request</button></form></section><% } %></main><%- include('../partials/footer') %>
